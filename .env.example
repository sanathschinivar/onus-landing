# Public ONUZ environment variables.
# These VITE_ values are included in the browser bundle; use only public webhook URLs.

# Deploy a Google Apps Script web app that accepts JSON from e.postData.contents.
# Use its HTTPS /macros/s/<deployment-id>/exec URL. Production builds reject placeholders.
VITE_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Optional: route drivers and CPO leads to separate sheets/deployments.
# Leave blank to use VITE_GOOGLE_SHEETS_WEBHOOK_URL for both.
VITE_GOOGLE_SHEETS_DRIVER_URL=
VITE_GOOGLE_SHEETS_CPO_URL=
